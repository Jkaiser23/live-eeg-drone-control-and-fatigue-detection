"""Train and save an EEG motor-imagery CSP classifier."""

from __future__ import annotations

import os

import joblib
import numpy as np
import pandas as pd
from mne.decoding import CSP
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import ConfusionMatrixDisplay, accuracy_score
from sklearn.model_selection import GroupShuffleSplit
from sklearn.preprocessing import LabelEncoder, StandardScaler


DATA_PATH = "data/processed/eeg_clean.csv"
MODEL_DIR = "models"
WINDOW_SIZE = 250
STEP_SIZE = 125


def make_windows(signal: np.ndarray, labels: np.ndarray):
    """Build labeled windows without joining separate labeled intervals."""
    windows, window_labels, groups = [], [], []
    run_id = -1
    start = 0
    while start < len(labels):
        end = start + 1
        while end < len(labels) and labels[end] == labels[start]:
            end += 1
        label = labels[start]
        if label != "rest":
            run_id += 1
            for offset in range(start, end - WINDOW_SIZE + 1, STEP_SIZE):
                windows.append(signal[offset:offset + WINDOW_SIZE].T)
                window_labels.append(label)
                groups.append(run_id)
        start = end
    if not windows:
        raise ValueError("No complete non-rest EEG windows found; collect longer trials")
    return np.asarray(windows), np.asarray(window_labels), np.asarray(groups)


def main() -> None:
    print("=== TRAIN MODEL (CSP PIPELINE) ===")
    if not os.path.exists(DATA_PATH):
        raise FileNotFoundError(f"Missing file: {DATA_PATH}")
    data = pd.read_csv(DATA_PATH)
    if "label" not in data or data.shape[1] < 2:
        raise ValueError("Processed data must contain EEG channels and a label column")
    signal_frame = data.drop(columns="label").apply(pd.to_numeric, errors="coerce")
    if signal_frame.isna().any().any() or data["label"].isna().any():
        raise ValueError("Processed data contains missing or non-numeric values")

    x, label_names, groups = make_windows(
        signal_frame.to_numpy(dtype=float), data["label"].astype(str).to_numpy()
    )
    encoder = LabelEncoder()
    y = encoder.fit_transform(label_names)
    if len(encoder.classes_) < 2:
        raise ValueError("At least two non-rest classes are required for training")
    if x.shape[1] < 2:
        raise ValueError("CSP training requires at least two EEG channels")
    if len(np.unique(groups)) < 2:
        raise ValueError("At least two separate task intervals are required for evaluation")

    # Keep every window from a trial together so overlapping windows cannot leak
    # between training and evaluation.
    splitter = GroupShuffleSplit(n_splits=100, test_size=0.2, random_state=42)
    split = None
    for train_idx, test_idx in splitter.split(x, y, groups):
        if len(np.unique(y[train_idx])) == len(encoder.classes_) and len(np.unique(y[test_idx])) >= 2:
            split = train_idx, test_idx
            break
    if split is None:
        raise ValueError("Could not make a trial-separated split containing all classes; record more trials")
    train_idx, test_idx = split
    scaler = StandardScaler()
    x_train_scaled = scaler.fit_transform(
        x[train_idx].transpose(0, 2, 1).reshape(-1, x.shape[1])
    ).reshape(len(train_idx), x.shape[2], x.shape[1]).transpose(0, 2, 1)
    x_test_scaled = scaler.transform(
        x[test_idx].transpose(0, 2, 1).reshape(-1, x.shape[1])
    ).reshape(len(test_idx), x.shape[2], x.shape[1]).transpose(0, 2, 1)
    components = min(4, x.shape[1])
    csp = CSP(n_components=components, log=True)
    x_train = csp.fit_transform(x_train_scaled, y[train_idx])
    x_test = csp.transform(x_test_scaled)

    model = RandomForestClassifier(n_estimators=200, random_state=42, class_weight="balanced")
    model.fit(x_train, y[train_idx])
    y_pred = model.predict(x_test)
    print(f"Clean windows: {len(x)}")
    print(f"Labels: {list(encoder.classes_)}")
    print(f"Trial-separated accuracy: {accuracy_score(y[test_idx], y_pred):.3f}")
    ConfusionMatrixDisplay.from_predictions(
        y[test_idx], y_pred, labels=np.arange(len(encoder.classes_)),
        display_labels=encoder.classes_, xticks_rotation="vertical"
    )
    import matplotlib.pyplot as plt
    plt.title("Confusion Matrix")
    plt.tight_layout()
    plt.show()

    os.makedirs(MODEL_DIR, exist_ok=True)
    joblib.dump(model, os.path.join(MODEL_DIR, "eeg_model.pkl"))
    joblib.dump(csp, os.path.join(MODEL_DIR, "csp.pkl"))
    joblib.dump(scaler, os.path.join(MODEL_DIR, "scaler.pkl"))
    joblib.dump(encoder, os.path.join(MODEL_DIR, "label_encoder.pkl"))
    print(f"Saved model, CSP transform, scaler, and label encoder to {MODEL_DIR}/")


if __name__ == "__main__":
    main()
